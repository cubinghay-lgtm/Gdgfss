# motio — configuration template. Copy to `.env` and fill in secrets.
#   cp .env.example .env
#
# motio's front end is a no-build static web app: the browser reads the
# Supabase URL + publishable key straight from js/sync.js (public by design,
# guarded by row-level security). This file is for BACKEND / TOOLING that runs
# in the background — edge-function deploys, health checks, admin scripts.
# Secrets (Google Maps, service role, Mapillary) must stay out of git.

# ---- Supabase project ----
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx     # safe for the browser (RLS-guarded)
SUPABASE_ANON_KEY=                              # legacy JWT (compat only)
SUPABASE_SERVICE_ROLE_KEY=                      # SECRET — server-only, never in the browser

# ---- Backend imagery/elevation edge function ----
IMAGERY_ENDPOINT=https://your-project-ref.supabase.co/functions/v1/imagery
GOOGLE_MAPS_API_KEY=                            # SECRET — edge function only; restrict in GCP
MAPILLARY_TOKEN=                                # optional community imagery
